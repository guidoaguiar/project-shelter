# Copy to .env next to compose.yaml, then: docker compose up -d --build
# The installers in install/ write this file for you.

COMPOSE_PROJECT_NAME=shelter
COMPOSE_PATH_SEPARATOR=:
# Linux (recommended):
COMPOSE_FILE=compose.yaml:compose.host.yaml
# macOS or Windows with Docker Desktop:
# COMPOSE_FILE=compose.yaml:compose.desktop.yaml

# Absolute path on this machine for settings, notes, stores, waypoints and Depot data.
# On Windows use forward slashes: C:/Users/you/Shelter/data
SHELTER_DATA_DIR=/opt/shelter/data

SHELTER_PORT=4077
# 127.0.0.1 = this machine only. 0.0.0.0 = also phones and tablets on your network.
SHELTER_BIND=127.0.0.1
# 1 = HTTPS with a self-signed certificate (made in SHELTER_DATA_DIR/tls). Phones need HTTPS to share
# their GPS position and to keep Shelter for offline use.
SHELTER_HTTPS=0

# Docker Desktop on Windows only: where the Docker VM sees SHELTER_DATA_DIR/depot.
# SHELTER_DEPOT_HOST_DIR=/run/desktop/mnt/host/c/Users/you/Shelter/data/depot

# Optional
# SHELTER_AI_URL=http://127.0.0.1:11434
# SHELTER_HOSTNAME=my-node
# SHELTER_HOST_LAN=192.168.1.20
# SHELTER_REMOTE_ADMIN=1
# SHELTER_DEPOT_UID=1000
# SHELTER_NET_CHECK=off
